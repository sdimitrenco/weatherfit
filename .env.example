# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Кому разрешено писать боту и кому уходит утренняя рассылка, через запятую.
# Свой chat_id можно узнать так: напиши боту любое сообщение и посмотри лог
# со строкой "сообщение от неизвестного chat_id".
TELEGRAM_ALLOWED_CHAT_IDS=123456789

LOCATION_NAME=Дрезден
LOCATION_LAT=51.05
LOCATION_LON=13.74
TZ_NAME=Europe/Berlin

# Время утренней рассылки в TZ_NAME
REPORT_TIME=07:00

# Часы, которые показываем в отчёте и по которым считаем советы
ACTIVE_HOURS=07-22

# ms | kmh
WIND_UNIT=ms

# debug | info | warn | error
LOG_LEVEL=info

# json (по умолчанию) | text — text удобнее при локальной отладке
LOG_FORMAT=json

# Где хранится дата последней успешной рассылки, чтобы досылать отчёт
# после перезапуска сервиса
STATE_FILE=data/state.json
