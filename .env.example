# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Приватный режим: если список задан, бот отвечает только этим chat_id.
# Пусто (по умолчанию) — бот открыт для всех, кто нажал /start.
TELEGRAM_ALLOWED_CHAT_IDS=

# Кому доступна команда /stats. Свой chat_id видно в логе при первом сообщению боту.
TELEGRAM_ADMIN_CHAT_IDS=

# Настройки нового подписчика: дальше каждый меняет их сам через /settings
LOCATION_NAME=Дрезден
LOCATION_LAT=51.05
LOCATION_LON=13.74
TZ_NAME=Europe/Berlin
REPORT_TIME=07:00
ACTIVE_HOURS=07-22

# ms | kmh
WIND_UNIT=ms

# en | ru | de — используется, если Telegram не прислал язык пользователя
DEFAULT_LANG=en

# lines — строки с эмодзи, table — моноширинная таблица в <pre>
HOURLY_LAYOUT=lines

# Файл SQLite с подписчиками и их настройками
DB_PATH=data/weatherfit.db

# debug | info | warn | error
LOG_LEVEL=info

# json (по умолчанию) | text — text удобнее при локальной отладке
LOG_FORMAT=json
